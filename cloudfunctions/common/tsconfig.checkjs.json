{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "./**/*.js",
    "./**/*.d.ts"
  ],
  "exclude": [
    "./**/__tests__/**"
  ]
}
