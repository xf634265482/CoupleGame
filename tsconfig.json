{
  /* Base configuration. Do not edit this field. */
  "extends": "./temp/tsconfig.cocos.json",

  /* Add your custom configuration here. */
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2015",
    "strict": false,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"]
  },
  "include": [
    "assets/scripts/**/*.ts",
    "shared/**/*.ts"
  ],
  "exclude": [
    "test/**",
    "extensions/**",
    "cloudfunctions/**",
    "temp/**",
    "node_modules/**"
  ]
}
