{
  "compilerOptions": {
    "target": "ES2019",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["jest", "node"],
    "paths": {
      "cc": ["test/__mocks__/cc.ts"],
      "cc/env": ["test/__mocks__/cc-env.ts"]
    }
  },
  "include": ["test/**/*.ts", "assets/scripts/pve/core/**/*.ts", "assets/scripts/ui/UiAssets.ts"]
}
